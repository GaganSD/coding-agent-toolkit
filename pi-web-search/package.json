{
  "name": "@gagansd/pi-web-search",
  "version": "0.4.0",
  "description": "One search tool for public web/code, URL extraction, and local evidence continuation. Cited, context-efficient, and keyless by default.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "exa",
    "parallel",
    "jev"
  ],
  "homepage": "https://github.com/GaganSD/coding-agent-toolkit/tree/main/pi-web-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/coding-agent-toolkit.git",
    "directory": "pi-web-search"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs",
    "dist/mcp.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "bench:context": "node --experimental-strip-types scripts/footprint.ts",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test:unit": "node ../scripts/test-package.mjs pi-web-search unit",
    "test:integration": "node ../scripts/test-package.mjs pi-web-search integration",
    "build": "npm run build:mcp && node ../scripts/package.mjs pi-web-search",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "pack:check": "node --experimental-strip-types scripts/pack-check.ts",
    "smoke:live": "node --experimental-strip-types scripts/live-smoke.ts",
    "smoke:classifier": "node --experimental-strip-types scripts/classifier-smoke.ts",
    "prepublishOnly": "npm run audit:prod && npm test && npm run typecheck && npm run pack:check",
    "build:mcp": "esbuild src/mcp-bin.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/mcp.js",
    "prepack": "npm run build:mcp",
    "research:record": "node --experimental-strip-types benchmarks/record.ts",
    "research:compare": "node --experimental-strip-types benchmarks/compare.ts",
    "research:ergonomics": "node --experimental-strip-types benchmarks/ergonomics.ts",
    "research:offline": "node --experimental-strip-types benchmarks/run.ts",
    "research:offtopic": "node --experimental-strip-types benchmarks/offtopic.ts",
    "research:urls": "node --experimental-strip-types benchmarks/live-url-reading.ts",
    "research:brave": "node --experimental-strip-types benchmarks/live-brave.ts"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@mozilla/readability": "0.6.0",
    "cross-spawn": "7.0.6",
    "proper-lockfile": "4.1.2",
    "turndown": "7.2.5",
    "typebox": "1.3.37",
    "unpdf": "2.2.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "overrides": {
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "bin": {
    "pi-web-search": "dist/mcp.js"
  }
}
