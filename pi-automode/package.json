{
  "name": "@gagansd/pi-automode",
  "version": "0.2.0",
  "description": "Supervised on/off permission gate for Pi (parent-only beta): extension plus verified SDK launcher.",
  "type": "module",
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "permission",
    "automode",
    "decision-model",
    "jev"
  ],
  "homepage": "https://github.com/GaganSD/coding-agent-toolkit/tree/main/pi-automode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/coding-agent-toolkit.git",
    "directory": "pi-automode"
  },
  "engines": {
    "node": ">=22.19"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "pi-automode": "bin/pi-automode.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./launcher": "./dist/launcher.js"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run compile && node ../scripts/package.mjs pi-automode",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings=0 --ignore-pattern dist",
    "test": "npm run compile && node scripts/run-tests.mjs",
    "test:unit": "npm run compile && node scripts/run-tests.mjs --suite unit",
    "test:integration": "npm run compile && node scripts/run-tests.mjs --suite integration",
    "check": "npm run typecheck && npm run build && npm test",
    "pack:check": "npm run clean && npm run compile && node scripts/pack-check.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "26.6.5",
    "typebox": "1.3.37",
    "typescript": "7.0.2"
  }
}
